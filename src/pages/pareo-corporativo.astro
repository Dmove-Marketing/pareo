---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/pareo-corporativo.css';

const IMG = 'https://media.dmove.com.br/clients/restaurantepareo/photos';

const gastronomia = [
  { src: `${IMG}/pareosalaocorporativo-gastronomia-1.jpeg`, alt: 'Mini porções em panelinhas de cobre com arroz, feijão branco e cubos crocantes' },
  { src: `${IMG}/pareosalaocorporativo-gastronomia-2.jpg`,  alt: 'Prato do chef Marcones Deus servido no Páreo' },
  { src: `${IMG}/pareosalaocorporativo-gastronomia-3.jpeg`, alt: 'Atum selado com purê e cebola assada, prato assinado pelo chef Marcones Deus' },
  { src: `${IMG}/pareosalaocorporativo-gastronomia-4.jpeg`, alt: 'Prato assinado da gastronomia do Páreo' },
  { src: `${IMG}/pareosalaocorporativo-gastronomia-5.jpeg`, alt: 'Prato da cozinha do Páreo com cortes nobres' },
  { src: `${IMG}/pareosalaocorporativo-gastronomia-6.jpeg`, alt: 'Prato assinado pelo chef Marcones Deus no Páreo' },
  { src: `${IMG}/pareosalaocorporativo-gastronomia-7.jpeg`, alt: 'Prato da alta gastronomia do Páreo' },
];

const clientes = [
  { src: `${IMG}/pareosalaocorporativo-clientes-1.png`,             alt: 'Cliente do Páreo',  cls: '' },
  { src: `${IMG}/pareosalaocorporativo-clientes-2-transparente.png`,alt: 'Cliente do Páreo',  cls: '' },
  { src: `${IMG}/pareosalaocorporativo-clientes-3.png`,             alt: 'Cliente do Páreo',  cls: '' },
  { src: `${IMG}/pareosalaocorporativo-clientes-4.webp`,            alt: 'Cliente do Páreo',  cls: 'logo-sm' },
  { src: `${IMG}/pareosalaocorporativo-clientes-5.svg`,             alt: 'Cliente do Páreo',  cls: 'logo-lg logo-white' },
  { src: `${IMG}/pareosalaocorporativo-clientes-6.png`,             alt: 'Cliente do Páreo',  cls: 'logo-lg' },
  { src: `${IMG}/pareosalaocorporativo-clientes-7.png`,             alt: 'Cliente do Páreo',  cls: '' },
  { src: `${IMG}/pareosalaocorporativo-clientes-8.png`,             alt: 'Cliente do Páreo',  cls: 'logo-xl logo-white' },
  { src: `${IMG}/pareosalaocorporativo-clientes-9.webp`,            alt: 'Cliente do Páreo',  cls: '' },
  { src: `${IMG}/pareosalaocorporativo-clientes-10.webp`,           alt: 'Cliente do Páreo',  cls: 'logo-sm' },
  { src: `${IMG}/pareosalaocorporativo-clientes-12.png`,            alt: 'Cliente do Páreo',  cls: '' },
];

// Mosaico de ambientes — size: big (2x2) | tall (1x2) | wide (2x1) | '' (1x1)
// A ordem importa: o conjunto fecha um grid de 4 colunas sem buracos.
const ambienteFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/pareo-corporativo/*.{jpg,jpeg,png}',
  { eager: true }
);
const ambientesBase = [
  { src: 'pareo-corporativo/ambiente-01.jpg', size: 'big',  alt: 'Salão Nobre em formato auditório com cadeiras de acrílico, telão e treliças de iluminação' },
  { src: 'pareo-corporativo/ambiente-02.jpg', size: '',     alt: 'Área de mesas altas com painéis de raquetes em neon e bar de doces ao fundo' },
  { src: 'pareo-corporativo/ambiente-03.jpg', size: 'tall', alt: 'Salão Nobre montado em formato auditório com cadeiras brancas e treliças de iluminação' },
  { src: 'pareo-corporativo/ambiente-04.png', size: '',     alt: 'Lounge com puffs azuis e dourados, pista iluminada e globos espelhados no teto' },
  { src: 'pareo-corporativo/ambiente-05.jpg', size: 'wide', alt: 'Salão Nobre com palco para banda, teto iluminado e lounge com sofá de veludo verde' },
  { src: 'pareo-corporativo/ambiente-06.png', size: 'wide', alt: 'Evento corporativo com palco, telão e lounge de puffs coloridos' },
  { src: 'pareo-corporativo/ambiente-07.jpg', size: '',     alt: 'Lounge com teto de folhagens, luminárias de madeira e vista para a varanda' },
  { src: 'pareo-corporativo/ambiente-08.jpg', size: '',     alt: 'Mesas compridas decoradas com castiçais na varanda coberta' },
  { src: 'pareo-corporativo/ambiente-09.jpg', size: 'big',  alt: 'Mesa de doces e bistrôs com painéis de raquetes iluminadas' },
  { src: 'pareo-corporativo/ambiente-10.jpg', size: 'wide', alt: 'Varanda coberta à noite com mesas redondas decoradas e lustres de velas' },
  { src: 'pareo-corporativo/ambiente-11.jpg', size: 'wide', alt: 'Pista e palco com painel de LED temático e teto iluminado' },
  { src: 'pareo-corporativo/ambiente-12.jpg', size: 'wide', alt: 'Festa com lounge colorido, pista cenográfica e globos espelhados' },
];
// Versão ampliada (WebP 1920px) para o lightbox
const ambientes = await Promise.all(ambientesBase.map(async (a) => {
  const mod = ambienteFiles[`/src/assets/images/${a.src}`];
  const full = mod ? (await getImage({ src: mod.default, width: 1920, format: 'webp' })).src : '';
  return { ...a, full };
}));

const leadFields: any[] = [
  { name: 'Nome',              type: 'text',     placeholder: 'Nome',              required: true,  full: true },
  { name: 'Telefone',          type: 'tel',      placeholder: 'Telefone',          required: true,  mask: 'phone' },
  { name: 'E-mail',            type: 'email',    placeholder: 'E-mail',            required: true  },
  { name: 'Data do evento',    type: 'date',     placeholder: 'Data do evento',    required: true },
  { name: 'Número de pessoas', type: 'number',   placeholder: 'Número de pessoas', required: true, min: '1' },
  { name: 'Tipo de evento', type: 'select', placeholder: '', required: true, full: true, options: [
    { value: '',                   label: 'Tipo de evento',              disabled: true, selected: true },
    { value: 'Casamento',          label: 'Casamento'                    },
    { value: 'Evento corporativo', label: 'Evento corporativo'           },
    { value: 'Debutante',          label: 'Debutante'                    },
    { value: 'Aniversário',        label: 'Aniversário'                  },
    { value: 'Formatura',          label: 'Formatura'                    },
    { value: 'Confraternização',   label: 'Confraternização / Fim de ano' },
    { value: 'Outro',              label: 'Outro'                        },
  ] },
  { name: 'Mensagem', type: 'textarea', placeholder: 'Detalhes adicionais (não obrigatório)', required: false, full: true },
];
---

<Base
  title="Páreo · Salão Nobre no Jockey Club do Rio de Janeiro"
  description="Salão Nobre do Páreo: 587m² dentro do Jockey Club, para até 500 convidados. O espaço ideal para eventos corporativos, casamentos, debutantes e aniversários no Rio de Janeiro."
  ogImage={`${IMG}/pareosalaocorporativo-hero.jpg`}
>

<a href="#sobre" class="skip-link">Pular para o conteúdo</a>

<header class="site-header">
  <div class="container">
    <a href="#hero" aria-label="Páreo">
      <Img src={`${IMG}/pareosalaocorporativo-logo.png`} alt="Logotipo Páreo" class="logo" priority />
    </a>
    <a class="btn" href="#contato">Solicitar contato</a>
  </div>
</header>

<main>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="bg">
      <Img src={`${IMG}/pareosalaocorporativo-hero.jpg`} alt="Lounge do Páreo decorado para evento, com poltronas azuis, mesas espelhadas e iluminação dourada" priority />
    </div>
    <div class="container">
      <div class="hero-copy">
        <span class="eyebrow">Páreo · Salão Nobre</span>
        <h1>O seu evento<br class="br-d"> corporativo<br class="br-m"> no<br class="br-d"> Jockey Club Brasileiro</h1>
        <p class="lead">Realize sua celebração no Salão Nobre,<br class="br-d"> com a assinatura do Páreo Buffet.</p>
        <a class="btn btn-solid" href="#contato">Comece a planejar</a>
      </div>

      <LeadForm
        formId="lead-form-hero"
        prefix="pch"
        class="form-panel sn-lf hero-form"
        project={config.project_slug}
        submitUrl={config.forms['lead-form'].webhooks[0]}
        redirectUrl={config.forms['lead-form'].redirect_on_success}
        submitText="Enviar solicitação"
        honeypot
        fields={leadFields}
      />
    </div>
  </section>

  <!-- FORMULÁRIO (só mobile: substitui o formulário da hero, que some em ≤900px) -->
  <section class="alt form-mobile" id="formulario">
    <div class="container">
      <LeadForm
        formId="lead-form-mobile"
        prefix="pcm"
        class="form-panel sn-lf"
        project={config.project_slug}
        submitUrl={config.forms['lead-form'].webhooks[0]}
        redirectUrl={config.forms['lead-form'].redirect_on_success}
        submitText="Enviar solicitação"
        honeypot
        fields={leadFields}
      />
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre">
    <div class="container">
      <div class="two-col">
        <div class="col-text">
          <span class="eyebrow">O Espaço</span>
          <h2>Há endereços<br class="br-d"> que<br class="br-m"> dispensam<br class="br-d"> apresentação</h2>
          <div class="divider"></div>
          <p>O Jockey Club Brasileiro é um deles. Um dos endereços mais seguros e tradicionais da Zona Sul do Rio, onde seu evento acontece com tranquilidade e estrutura.</p>
          <p>É aqui que o Páreo Buffet recebe eventos corporativos que conectam pessoas, marcas e grandes momentos.</p>
        </div>
        <div class="col-media">
          <Img src={`${IMG}/pareosalaocorporativo-sobre.jpg`} alt="Vista aérea do Jockey Club Brasileiro, no Rio de Janeiro, onde está localizado o Páreo" />
        </div>
      </div>
    </div>
  </section>

  <!-- ESTRUTURA -->
  <section class="alt" id="estrutura">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ambientes</span>
        <h2>Contemple registros reais<br class="br-d"> do Salão Nobre</h2>
        <p>Com 587m² e capacidade de 100 a 500 convidados, o Salão Nobre foi desenhado para receber grandes celebrações sem abrir mão da elegância.</p>
      </div>
      <!-- Desktop: mosaico · Mobile (≤640px): carrossel com bolinhas (mesmo padrão de /salao-nobre-casamento) -->
      <div class="ambientes-slider">
        <div class="mosaico-ambientes">
          {ambientes.map((a) => (
            <button type="button" class={a.size || undefined} data-full={a.full} aria-label={`Ampliar foto: ${a.alt}`}>
              <Img src={a.src} alt={a.alt} width={a.size === 'big' ? 1200 : 800} />
            </button>
          ))}
        </div>
        <div class="slider-dots">
          {ambientes.map((_, i) => <button type="button" aria-label={`Ir para a foto ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
        </div>
      </div>
    </div>
  </section>

  <!-- GASTRONOMIA -->
  <section id="gastronomia">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Gastronomia</span>
        <h2>Gastronomia internacional<br>com identidade brasileira</h2>
        <p>Sob o comando do chef Marcones Deus, a alta gastronomia do Páreo Buffet<br class="br-d"> transita pelo mundo sem perder a identidade brasileira.</p>
      </div>
    </div>
    <div class="carrossel-gastronomia" aria-label="Galeria de gastronomia">
      <div class="carrossel-track">
        {gastronomia.map((g) => <figure><Img src={g.src} alt={g.alt} /></figure>)}
        {gastronomia.map((g) => <figure aria-hidden="true"><img src={g.src} alt="" loading="lazy" /></figure>)}
      </div>
    </div>
  </section>

  <!-- PARALLAX -->
  <section
    class="parallax"
    id="experiencia"
    role="img"
    aria-label="Varanda do Páreo iluminada à noite, com lounge decorado para evento"
    style={`background-image:url('${IMG}/pareosalaocorporativo-paralax.jpeg')`}
  ></section>

  <!-- CLIENTES -->
  <section id="clientes">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Clientes</span>
        <h2>Nossos Clientes</h2>
        <p>Parceiros que confiam na excelência do Páreo.</p>
      </div>
    </div>
    <div class="carrossel-clientes" aria-label="Logotipos de clientes parceiros">
      <div class="carrossel-track-clientes">
        {clientes.map((c) => <Img src={c.src} alt={c.alt} class={c.cls || undefined} />)}
        {clientes.map((c) => <Img src={c.src} alt="" class={c.cls || undefined} />)}
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section class="contato" id="contato">
    <div class="bg">
      <Img src={`${IMG}/pareosalaocorporativo-hero.jpg`} alt="Ambiente do Páreo preparado para receber convidados" />
    </div>
    <div class="container">
      <div class="intro">
        <span class="eyebrow">Contato</span>
        <h2>Quero planejar<br>um evento incrível!</h2>
        <p>Preencha o formulário para receber nosso contato.</p>
      </div>

      <LeadForm
        formId="lead-form"
        prefix="pcc"
        class="form-panel sn-lf"
        project={config.project_slug}
        submitUrl={config.forms['lead-form'].webhooks[0]}
        redirectUrl={config.forms['lead-form'].redirect_on_success}
        submitText="Enviar solicitação"
        honeypot
        fields={leadFields}
      />
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="container">
    <div class="f-logo"><Img src={`${IMG}/logo-pareo_resultado.webp`} alt="Páreo" /></div>
    <p>Copyright © 2026 Páreo · Todos os direitos reservados</p>
    <div class="by">Desenvolvido por <a href="https://dmove.com.br" target="_blank" rel="noopener noreferrer"><Img src="https://media.dmove.com.br/clients/dmove/photos/logo-dmove.webp" alt="Dmove" /></a></div>
  </div>
</footer>

<!-- Lightbox do mosaico de ambientes -->
<div id="lightbox">
  <button type="button" class="close" aria-label="Fechar">✕</button>
  <img src="" alt="" />
</div>

</Base>
<script>
  import '../scripts/pareo-corporativo.js';
</script>
