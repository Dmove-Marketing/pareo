---
// Redireciona a home para /casamentos, preservando UTMs e demais query params.
const target = '/casamentos';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <link rel="canonical" href="https://eventos.restaurantepareo.com.br/casamentos" />
  <title>Páreo Eventos</title>
</head>
<body>
  <script define:vars={{ target }}>
    window.location.replace(target + window.location.search);
  </script>
</body>
</html>
