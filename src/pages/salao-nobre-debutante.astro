---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/salao-nobre-debutante.css';

const IMG = 'https://media.dmove.com.br/clients/restaurantepareo/photos';

const cerimonialValsa = [
  { src: `${IMG}/pareosalaonobre-debutante-cerimonialvalsa-1.jpg`, alt: 'Debutante dançando a valsa no centro do Salão Nobre, sob as luzes voltadas para ela' },
  { src: `${IMG}/pareosalaonobre-debutante-cerimonialvalsa-2.jpg`, alt: 'Momento da valsa de debutante no Salão Nobre do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-cerimonialvalsa-3.jpg`, alt: 'Cerimonial de valsa em festa de 15 anos no Páreo' },
];

const festaPista = [
  { src: `${IMG}/pareosalaonobre-debutante-festapista-1.jpg`, alt: 'Debutante de vestido rosa dançando coreografia com amigas de vestidos roxos na pista do Salão Nobre' },
  { src: `${IMG}/pareosalaonobre-debutante-festapista-2.jpg`, alt: 'Debutante erguida pelos amigos no centro da pista de dança do Páreo, sob luzes douradas' },
  { src: `${IMG}/pareosalaonobre-debutante-festapista-3.jpg`, alt: 'Convidados na pista diante do DJ e da iluminação cênica do Salão Nobre' },
];

const carrosselDebutantes = [
  { src: `${IMG}/pareosalaonobre-debutante-carrosselinfinito-1.jpg`, alt: 'Detalhe de festa de debutante no Salão Nobre do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-carrosselinfinito-2.jpg`, alt: 'Debutante e convidados no Salão Nobre do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-carrosselinfinito-3.jpg`, alt: 'Decoração de festa de 15 anos no Salão Nobre do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-carrosselinfinito-4.jpg`, alt: 'Pista de dança iluminada em festa de debutante no Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-carrosselinfinito-5.jpg`, alt: 'Mesa decorada para festa de 15 anos no Salão Nobre do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-carrosselinfinito-6.jpg`, alt: 'Momento da valsa em festa de debutante no Salão Nobre do Páreo' },
];

const gastronomia = [
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-1.jpg`, alt: 'Mini porções em panelinhas de cobre com arroz, feijão branco e cubos crocantes' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-2.jpg`, alt: 'Prato do chef Marcones Deus servido no Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-3.jpg`, alt: 'Atum selado com purê e cebola assada, prato assinado pelo chef Marcones Deus' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-4.jpg`, alt: 'Prato assinado da gastronomia do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-5.jpg`, alt: 'Prato da cozinha do Páreo com cortes nobres' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-6.jpg`, alt: 'Prato assinado pelo chef Marcones Deus no Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-7.jpg`, alt: 'Prato da alta gastronomia do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-8.jpg`, alt: 'Sobremesa assinada da gastronomia do Páreo' },
  { src: `${IMG}/pareosalaonobre-debutante-gastronomia-9.jpg`, alt: 'Detalhe de prato servido no Páreo' },
];

const galeria = [
  { src: `${IMG}/pareosalaonobre-debutante-galeria-1.jpg`,  alt: 'Festa temática no Salão Nobre com decoração colorida', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-2.jpg`,  alt: 'Evento decorado no Salão Nobre do Páreo', tall: true },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-3.jpg`,  alt: 'Detalhe da decoração de evento no Salão Nobre', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-4.jpg`,  alt: 'Mesa decorada em evento realizado no Salão Nobre', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-5.jpg`,  alt: 'Ambiente do Salão Nobre montado para celebração', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-6.jpg`,  alt: 'Convidados em evento no Salão Nobre do Páreo', tall: true },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-7.jpg`,  alt: 'Decoração de festa no Salão Nobre', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-8.jpg`,  alt: 'Detalhe de arranjo floral em evento no Salão Nobre', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-9.jpg`,  alt: 'Cenografia temática em festa de debutante no Salão Nobre', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-10.jpg`, alt: 'Salão Nobre decorado para grande evento', tall: true },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-11.jpg`, alt: 'Pista de dança montada no Salão Nobre', tall: false },
  { src: `${IMG}/pareosalaonobre-debutante-galeria-12.jpg`, alt: 'Detalhe de iluminação em evento no Salão Nobre', tall: false },
];

const leadFields: any[] = [
  { name: 'Nome',              type: 'text',     placeholder: 'Nome',              required: true,  full: true },
  { name: 'Telefone',          type: 'tel',      placeholder: 'Telefone',          required: true,  mask: 'phone' },
  { name: 'E-mail',            type: 'email',    placeholder: 'E-mail',            required: true  },
  { name: 'Data do evento',    type: 'date',     placeholder: 'Data do evento',    required: true },
  { name: 'Número de pessoas', type: 'number',   placeholder: 'Número de pessoas', required: true, min: '1' },
  { name: 'Tipo de evento', type: 'select', placeholder: '', required: true, full: true, options: [
    { value: '',                   label: 'Tipo de evento',              disabled: true, selected: true },
    { value: 'Casamento',          label: 'Casamento'                    },
    { value: 'Evento corporativo', label: 'Evento corporativo'           },
    { value: 'Debutante',          label: 'Debutante'                    },
    { value: 'Aniversário',        label: 'Aniversário'                  },
    { value: 'Formatura',          label: 'Formatura'                    },
    { value: 'Confraternização',   label: 'Confraternização / Fim de ano' },
    { value: 'Outro',              label: 'Outro'                        },
  ] },
  { name: 'Mensagem', type: 'textarea', placeholder: 'Detalhes adicionais (não obrigatório)', required: false, full: true },
];
---

<Base
  title="Páreo · Festa de 15 Anos no Salão Nobre do Jockey Club do Rio de Janeiro"
  description="O Páreo Buffet recebe sua festa de debutante no Salão Nobre do Jockey Club, na Zona Sul do Rio de Janeiro. 587m² de sofisticação, para até 500 convidados."
  ogImage={`${IMG}/pareosalaonobre-debutante-hero.jpg`}
>

<a href="#sobre" class="skip-link">Pular para o conteúdo</a>

<header class="site-header">
  <div class="container">
    <a href="#hero" aria-label="Páreo">
      <Img src={`${IMG}/pareosalaocorporativo-logo.png`} alt="Logotipo Páreo" class="logo" priority />
    </a>
    <a class="btn" href="#contato">Solicitar contato</a>
  </div>
</header>

<main>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="bg">
      <Img src="salao-nobre-debutante/hero.webp" alt="Debutante de vestido de baile coral na pista de dança do Salão Nobre do Páreo" width={1536} priority />
    </div>
    <div class="container">
      <div class="hero-copy">
        <span class="eyebrow">Páreo · Salão Nobre</span>
        <h1><span class="quebra-desktop">Comemore<br>seus 15 anos<br>no cenário<br>mais desejado<br>da Zona Sul</span><span class="quebra-mobile">Comemore seus 15 anos<br>no cenário mais desejado<br>da Zona Sul</span></h1>
        <p class="lead">O Páreo Buffet recebe sua festa<br>de debutante no Salão Nobre<br>do Jockey Club.</p>
        <a class="btn btn-solid" href="#contato">Solicite um contato</a>
      </div>

      <LeadForm
        formId="lead-form-hero"
        prefix="pdh"
        class="form-panel sn-lf hero-form"
        project={config.project_slug}
        submitUrl={config.forms['lead-form'].webhooks[0]}
        redirectUrl={config.forms['lead-form'].redirect_on_success}
        submitText="Enviar solicitação"
        honeypot
        fields={leadFields}
      />
    </div>
  </section>

  <!-- FORMULÁRIO (só mobile: substitui o formulário da hero, que some em ≤900px) -->
  <section class="alt form-mobile" id="formulario">
    <div class="container">
      <LeadForm
        formId="lead-form-mobile"
        prefix="pdm"
        class="form-panel sn-lf"
        project={config.project_slug}
        submitUrl={config.forms['lead-form'].webhooks[0]}
        redirectUrl={config.forms['lead-form'].redirect_on_success}
        submitText="Enviar solicitação"
        honeypot
        fields={leadFields}
      />
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre">
    <div class="container">
      <div class="two-col">
        <div class="col-text">
          <span class="eyebrow">O Espaço</span>
          <h2>Para debutantes<br>que não abrem mão<br>do extraordinário</h2>
          <div class="divider"></div>
          <p>A tradição do Jockey Club Brasileiro e a sofisticação da Zona Sul no mesmo lugar. Um endereço tradicional, com localização privilegiada e toda a segurança que uma celebração desse porte pede.</p>
          <p>É&nbsp;aqui que o Páreo recebe sua festa de 15&nbsp;anos. O Salão Nobre é uma tela em branco para criar uma celebração com a sua identidade, de 100 a 500&nbsp;convidados.</p>
        </div>
        <div class="col-media">
          <Img src={`${IMG}/pareosalaonobre-debutante-sobre.jpg`} alt="Vista aérea do Jockey Club Brasileiro, no Rio de Janeiro, onde está localizado o Páreo" />
        </div>
      </div>
    </div>
  </section>

  <!-- CERIMONIAL E VALSA -->
  <section class="alt" id="cerimonial-valsa">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cerimonial e Valsa</span>
        <h2>O momento em<br>que seu sonho<br>se torna realidade</h2>
        <div class="divider"></div>
        <p><span class="quebra-desktop">Sinta seu coração acelerar quando as luzes se voltarem<br>para você no grande momento da valsa.</span><span class="quebra-mobile">Sinta seu coração acelerar quando<br>as luzes se voltarem para você<br>no grande momento da valsa.</span></p>
      </div>
    </div>
    <div class="palco" data-palco aria-label="Fotos do cerimonial e da valsa">
      {cerimonialValsa.map((s, i) => (
        <button type="button" class={`palco-painel${i === 0 ? ' is-active' : ''}`} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Foto ${i + 1} de ${cerimonialValsa.length}`}>
          <Img src={s.src} alt={s.alt} width={1600} loading="eager" />
          <span class="palco-progresso" aria-hidden="true"></span>
        </button>
      ))}
    </div>
  </section>

  <!-- FESTA E PISTA DE DANÇA -->
  <section id="festa-pista">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Festa</span>
        <h2>Dance até<br>o fim da noite</h2>
        <div class="divider"></div>
        <p><span class="quebra-desktop">Transforme a pista de dança em um verdadeiro<br>palco e crie o espetáculo que só a sua festa<br>de 15 anos pode ter.</span><span class="quebra-mobile">Transforme a pista de dança em um<br>verdadeiro palco e crie o espetáculo<br>que só a sua festa de 15 anos pode ter.</span></p>
      </div>
    </div>
    <div class="carrossel-festa" aria-roledescription="carrossel" aria-label="Fotos da festa e da pista de dança">
      <div class="cf-track" tabindex="0">
        {festaPista.map((f, i) => (
          <figure class="cf-slide" aria-roledescription="slide" aria-label={`${i + 1} de ${festaPista.length}`}>
            <Img src={f.src} alt={f.alt} width={1400} />
          </figure>
        ))}
      </div>
    </div>
    <div class="cf-dots">
      {festaPista.map((_, i) => <button type="button" aria-label={`Ir para a foto ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
    </div>
  </section>

  <!-- CARROSSEL DEBUTANTES -->
  <section class="alt" id="carrossel-debutantes">
    <div class="carrossel-infinito" aria-label="Galeria de festas de debutante">
      <div class="carrossel-track">
        {carrosselDebutantes.map((img) => <Img src={img.src} alt={img.alt} />)}
        {carrosselDebutantes.map((img) => <img src={img.src} alt="" aria-hidden="true" loading="lazy" />)}
      </div>
    </div>
  </section>

  <!-- GASTRONOMIA -->
  <section id="gastronomia">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Gastronomia</span>
        <h2>Gastronomia internacional<br>com alma brasileira</h2>
        <p>No comando da cozinha, o chef Marcones Deus assina a alta gastronomia<br class="brk">do Páreo, combinando ingredientes clássicos com muita brasilidade.</p>
      </div>
    </div>
    <div class="carrossel-infinito" aria-label="Galeria de gastronomia">
      <div class="carrossel-track">
        {gastronomia.map((g) => <Img src={g.src} alt={g.alt} />)}
        {gastronomia.map((g) => <img src={g.src} alt="" aria-hidden="true" loading="lazy" />)}
      </div>
    </div>
    <div class="container">
      <p class="gastronomia-fechamento" style="max-width:640px; margin:40px auto 0; text-align:center;"><span class="quebra-desktop">Do menu autoral aos clássicos reinventados, cada prato<br>é pensado para surpreender você e seus convidados.</span><span class="quebra-mobile">Do menu autoral aos clássicos<br>reinventados, cada prato<br>é pensado para surpreender<br>você e seus convidados.</span></p>
    </div>
  </section>

  <!-- PARALLAX -->
  <section
    class="parallax"
    id="experiencia"
    style={`background-image: url('${IMG}/pareosalaonobre-debutante-paralax.jpg')`}
    role="img"
    aria-label="Varanda do Páreo iluminada à noite, com lounge decorado para festa de debutante"
  ></section>

  <!-- GALERIA -->
  <section id="galeria">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Galeria</span>
        <h2><span class="quebra-desktop">Pelos olhos de quem viveu</span><span class="quebra-mobile">Pelos olhos de<br>quem viveu</span></h2>
        <p>Veja registros de debutantes que confiaram no Páreo e se inspire<br class="brk">para criar a sua própria festa de 15 anos.</p>
      </div>
      <div class="galeria-grid">
        {galeria.map((item) => (
          <button type="button" class={item.tall ? 'tall' : undefined} data-full={item.src}>
            <Img src={item.src} alt={item.alt} />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section class="contato" id="contato">
    <div class="bg">
      <Img src={`${IMG}/pareosalaonobre-debutante-contato.jpg`} alt="Ambiente do Páreo preparado para receber convidados" />
    </div>
    <div class="container">
      <div class="intro">
        <span class="eyebrow">Contato</span>
        <h2>Vamos planejar sua<br>festa de 15 anos?</h2>
        <p>Preencha o formulário para receber<br>uma proposta personalizada.</p>
      </div>

      <LeadForm
        formId="lead-form"
        prefix="pdc"
        class="form-panel sn-lf"
        project={config.project_slug}
        submitUrl={config.forms['lead-form'].webhooks[0]}
        redirectUrl={config.forms['lead-form'].redirect_on_success}
        submitText="Enviar solicitação"
        honeypot
        fields={leadFields}
      />
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="container">
    <div class="f-logo"><Img src={`${IMG}/logo-pareo_resultado.webp`} alt="Páreo" /></div>
    <p>Copyright © 2026 Páreo · Todos os direitos reservados</p>
    <div class="by">Desenvolvido por <a href="https://dmove.com.br" target="_blank" rel="noopener noreferrer"><Img src="https://media.dmove.com.br/clients/dmove/photos/logo-dmove.webp" alt="Dmove" /></a></div>
  </div>
</footer>

<div id="lightbox">
  <button type="button" class="close" aria-label="Fechar">✕</button>
  <img src="" alt="" />
</div>

</Base>
<script>
  import '../scripts/salao-nobre-debutante.js';
</script>
